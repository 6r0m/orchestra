{
  "agents": {
    "claude-engineer": {
      "kind": "claude-code",
      "model": "claude-opus-5-5",
      "effort": "xhigh"
    },
    "claude-architect": {
      "kind": "claude-code",
      "model": "claude-fable-5-1",
      "effort": "xhigh"
    },
    "codex-engineer": {
      "kind": "codex",
      "model": "gpt-6.1-sol",
      "effort": "high"
    },
    "codex-architect": {
      "kind": "codex",
      "model": "gpt-6.1-sol",
      "effort": "xhigh"
    }
  },
  "roles": {
    "engineer": {
      "agent": "claude-engineer",
      "persona_file": "roles/engineer.md"
    },
    "architect": {
      "agent": "codex-architect",
      "persona_file": "roles/architect.md"
    }
  },
  "stage_skills": {
    "research": "architect",
    "plan": "investigate-change",
    "assess": "architect",
    "build": "implement-approved-change",
    "verify": "architect"
  },
  "review_rounds": {
    "plan": {
      "normal": 10,
      "extended": 10
    },
    "build": {
      "normal": 10,
      "extended": 10
    }
  },
  "auto_proceed": false,
  "default_flow": "engineer-code",
  "timeout_seconds": 3600,
  "workbench_port": 8390,
  "heartbeat_seconds": 120,
  "workflow_queue": "orchestration",
  "targets": {
    "wsl": {"host": "local", "worktree_root": "~/worktrees", "terminal_port": 8091},
    "windows": {"host": "local", "worktree_root": "E:\\Worktrees", "terminal_port": 8092}
  },
  "target_repo": {
    "commit_allowed": false,
    "push_allowed": false,
    "merge_allowed": false
  }
}
