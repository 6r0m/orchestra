# This repository is public. Everything below is either private to a machine or generated by a run.

# The one private file: credentials and machine-specific values. `.env.example` names its keys.
.env
.env.*
!.env.example

# The repositories this checkout runs on — yours, named by absolute path.
repos.json

# Generated by runs: worktrees' logs, terminal records, pids, the workbench token.
tmp/
secrets/

# Never, whatever produced them.
*.token
*.pem
*.key
*.p12
*.pfx

# Toolchain and editor leavings.
.venv/
__pycache__/
*.pyc
.playwright-cli/
.pytest_cache/
