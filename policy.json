{
  "roles": {
    "engineer": {
      "brain": "claude",
      "workspace_access": "write",
      "prompt": "roles/engineer.md"
    },
    "architect": {
      "brain": "codex",
      "workspace_access": "read",
      "prompt": "roles/architect.md",
      "model": "gpt-5.6-sol",
      "reasoning_effort": "high"
    }
  },
  "max_rounds": {
    "plan": 2,
    "build": 2
  },
  "auto_proceed": false,
  "timeout_seconds": 3600,
  "workbench_port": 8390,
  "heartbeat_seconds": 120,
  "workflow_queue": "orchestration",
  "targets": {
    "wsl": {"host": "local", "worktree_root": "~/worktrees", "terminal_port": 8091},
    "windows": {"host": "local", "worktree_root": "C:\\Worktrees", "terminal_port": 8092}
  },
  "target_repo": {
    "commit_allowed": false,
    "push_allowed": false,
    "merge_allowed": false
  }
}
