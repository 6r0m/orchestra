# Copy to `.env`. It holds credentials and the few values that belong to one machine. `.env` is
# gitignored; never put a real value in this example. Run behavior defaults are in
# `.orchestra/settings.json`; local overrides are kept in the ignored `settings.local.json` beside it.

# The local Temporal stack's PostgreSQL password. The database is only on the Compose network.
# Set this before the first start to use your own password instead of the local Compose default.
TEMPORAL_DB_PASSWORD=

# Optional for Claude Code profiles selecting DeepSeek; read at each turn, with environment precedence.
# Pi uses its native provider authentication or worker environment instead. Never put keys in settings.
DEEPSEEK_API_KEY=

# Optional: the trace of a run — its phases, role turns, stops, verdicts and final diff.
# Without a key pair a run behaves identically and records nothing.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Where these runs' rows are filed. `fixture` is used by the tools; leave unset for real runs.
# LANGFUSE_TRACING_ENVIRONMENT=

# For a separately managed stack, export the following in the process environment as needed.
# Workbench and worker processes read these overrides from their environment.
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=orchestration
# A complete settings file replaces the shared settings and local patch and shows as read-only.
# ORCHESTRA_SETTINGS=/path/to/settings.json
# A descriptor file replaces the checkout's `.orchestra/repos.json`.
# ORCHESTRA_REPOS=/path/to/your/repos.json
