# Copy to `.env`. This is the only private file Orchestra reads: credentials and the few values
# that belong to one machine. Everything about how runs behave is public configuration in
# `policy.json`. `.env` is gitignored; never put a real value in this example.

# The Temporal server a run's workflow lives on. The stack in `temporal/` publishes this.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=orchestration

# The password the local Temporal stack's PostgreSQL uses. It is never published outside the
# compose network; set it anyway so no default is carried in the compose file.
TEMPORAL_DB_PASSWORD=

# Optional: the trace of a run — its phases, role turns, stops, verdicts and final diff.
# Without a key pair a run behaves identically and records nothing.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Where these runs' rows are filed. `fixture` is used by the tools; leave unset for real runs.
# LANGFUSE_TRACING_ENVIRONMENT=

# Optional: a policy file of your own, instead of the one this repository ships — for example to
# bind your own skills to the stages (`stage_skills`) or to name this host's worktree roots.
# ORCH_POLICY=/path/to/your/policy.json

# Optional: a descriptor file of your own, instead of `repos.json` beside this file.
# ORCH_REPOS=/path/to/your/repos.json
